      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 8,
        "preview": "“‘AYE,’ HE SAID, ‘YOU’RE AN ARDEN, FOR SURE.’”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 9,
        "preview": "“THEY WERE TURNING ITS PAGES WITH QUICK, ANXIOUS HANDS.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 7,
        "preview": "“THE CHILDREN WENT IN THE CARRIER’S CART.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 13,
        "preview": "“‘HOITY-TOITY,’ SAID THE OLD LADY VERY SEVERELY; ‘WE FORGET OUR MANNERS, I THINK.’”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 9,
        "preview": "“‘I’VE BROUGHT YOU SOME TEA AND SUGAR,’ SHE SAID.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 14,
        "preview": "“THE MOULDIWARP MADE A LITTLE RUN AND A LITTLE JUMP, AND ELFRIDA CAUGHT IT.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 13,
        "preview": "“‘DO YOU THINK THE FRENCH WILL LAND TO-MORROW IN LYMCHURCH BAY?’ EDRED ASKED.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 10,
        "preview": "“THEY SAT DOWN ON THE CLOSE, WHITE LINE OF DAISIES.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 14,
        "preview": "“‘COME, SEE HOW THE NEW SCARF BECOMES THY BET. IS IT NOT VASTLY MODISH?’”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 9,
        "preview": "“IF YOU AIM AT ME YOU SHOOT THE CHILD.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 5,
        "preview": "“BETTY HANDED HIM THE CANDLE.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 9,
        "preview": "“‘NOW,’ SAID A DOZEN VOICES, ‘THE TRUTH, LITTLE MISS.’”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 6,
        "preview": "“ELFRIDA WAS OBLIGED TO SHAKE HIM.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 9,
        "preview": "“EDRED AND THE BIG CHAIR FELL TO THE FLOOR.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 8,
        "preview": "“SHE SAW THAT THE NAME WAS ‘E. TALBOT.’”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 7,
        "preview": "“THE ROOM SEEMED FULL OF CIRCLING WINGS.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 10,
        "preview": "“A LADY IN CRIMSON AND ERMINE WITH A GOLD CROWN.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 10,
        "preview": "“THE WALLS SEEMED TO TREMBLE AND SHAKE AND GO CROOKED.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 17,
        "preview": "“‘THOU’RT A FINE PAGE, INDEED, MY DEAR SON,’ SAID THE LADY. ‘STAND ASIDE AND TAKE MY TRAIN.’”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 7,
        "preview": "“OLD PARROT-NOSE HAD ELFRIDA BY THE WRIST.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 9,
        "preview": "“THEY FOUND THEIR HOUSE OCCUPIED BY AN ARMED GUARD.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 14,
        "preview": "“‘I WILL CONVEY HIM TO OUR COACH, GOOD MASTERS,’ SHE SAID TO THE GUARD.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 8,
        "preview": "“‘YOU’VE NO MANNERS,’ IT SAID TO THE NURSE.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 11,
        "preview": "“THE STREAM CAME OUT UNDER A ROUGH, LOW ARCH OF STONE.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 7,
        "preview": "“‘SOLDIERS!’ SHE CRIED, ‘AND THEY’RE AFTER US.’”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 17,
        "preview": "“MRS. HONEYSETT WAS SITTING IN A LITTLE LOW CHAIR AT THE BACK DOOR PLUCKING A WHITE CHICKEN.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 18,
        "preview": "“‘AH,’ SAID OLD BEALE ADMIRINGLY, ‘YOU’LL BE A-BUSTING WITH BOOK-LARNIN’ AFORE YOU COME TO YOUR TWEN"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 11,
        "preview": "“IT HELD CLOTHES FAR RICHER THAN ANY THEY HAD SEEN YET.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 9,
        "preview": "“‘NOW RUN!’ SHE SAID, AND HERSELF LED THE WAY.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 7,
        "preview": "“THEY ALL JUMPED ON THE WHITE CLOCK.”"
      },
      {
        "reason": "navigation-or-illustration",
        "source_id": "",
        "words": 9,
        "preview": "“THE HOUSES WERE MADE OF GREAT BLOCKS OF STONE.”"
      },
      {
